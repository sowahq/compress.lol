{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "compress-lol",
	"account_id": "b002cc6e1fe46091b270bcb3ff900845",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": false,
	"vars": {
		"PUBLIC_UMAMI_WEBSITE_ID": "7dc6161d-a41d-454a-851d-79e9e89f4bd3"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [
		{ "pattern": "compress.lol", "custom_domain": true },
		{ "pattern": "www.compress.lol", "custom_domain": true }
	]
}
